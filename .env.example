# ── Application ──────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# ── Database (PostgreSQL 15) ──────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=
DB_NAME=lucencare
DB_SSL=false
# Log every SQL statement (routed through the Nest/pino logger). Off by default
# in dev too — noisy. Flip to true for a one-off debugging session.
DB_LOG_QUERIES=false

# ── Redis 7.x ─────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TLS=false

# ── JWT RS256 ─────────────────────────────────────────────────────────────────
# Provide full PEM-encoded key strings (multi-line, use \n escapes in production secrets)
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_ACCESS_TOKEN_EXPIRES_IN=15m
JWT_REFRESH_TOKEN_EXPIRES_IN=7d

# ── S3-compatible Object Storage ──────────────────────────────────────────────
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=lucencare-exports
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ── Rate Limiting ─────────────────────────────────────────────────────────────
# Default window: 60 req / 60 s per userId
THROTTLE_TTL=60
THROTTLE_LIMIT=60

# Auth endpoints: 10 req / 60 s per IP
AUTH_THROTTLE_TTL=60
AUTH_THROTTLE_LIMIT=10

# OTP endpoints: 3 req / 300 s per userId
OTP_THROTTLE_TTL=300
OTP_THROTTLE_LIMIT=3

# Export token endpoint: 5 req / 60 s per orgId
EXPORT_THROTTLE_TTL=60
EXPORT_THROTTLE_LIMIT=5

# ── OTP ───────────────────────────────────────────────────────────────────────
OTP_TTL_SECONDS=300

# ── bcrypt ────────────────────────────────────────────────────────────────────
BCRYPT_SALT_ROUNDS=12

# ── Background Jobs ────────────────────────────────────────────────────────────
# Cron pattern for the medication reminder tick (checks for due reminders and
# enqueues send jobs). Lower = more timely reminders but more Redis command
# volume from the repeatable job's bookkeeping; higher = cheaper but reminders
# can lag behind their scheduled time by up to one interval.
MEDICATION_REMINDER_TICK_CRON=*/30 * * * *

# How long after its scheduled time a dose stays actionable before it is marked
# MISSED. Both values must be greater than the 15-minute due-now window, and the
# LATER grace should be >= the default grace since the patient deferred that dose
# on purpose. Measured from the original scheduled time in the patient's timezone.
MEDICATION_DOSE_GRACE_MINUTES=60
MEDICATION_LATER_DOSE_GRACE_MINUTES=120

# Cron pattern for the sweep that persists MISSED on doses past their grace.
# Only ever marks doses already past grace, so a slower tick delays persistence
# without risk of marking one early.
MEDICATION_MISSED_SWEEP_CRON=*/15 * * * *

# Appointment reminders go out 3 days before, 1 hour before, and at the appointment's
# own start time (see APPOINTMENT_REMINDER_LEAD_MINUTES). These two are a COUPLED PAIR:
# the window must EQUAL the tick interval, or reminders are either missed or duplicated.
APPOINTMENT_REMINDER_TICK_CRON=*/5 * * * *
APPOINTMENT_REMINDER_WINDOW_MINUTES=5

# ── WebSocket ─────────────────────────────────────────────────────────────────
WS_CORS_ORIGIN=http://localhost:3001

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:3001

# ── Cookies ───────────────────────────────────────────────────────────────────
# true when the API and the SPA are on different registrable domains, which makes the
# refresh cookie SameSite=None; Secure; Partitioned so the browser will actually send it
# on POST /auth/refresh. Requires HTTPS. Leave false when both share a site.
CROSS_SITE_COOKIES=false

# ── SMTP Mail ─────────────────────────────────────────────────────────────────
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="LucenCare <no-reply@lucencare.com>"

# ── Frontend URL (used to build links in transactional emails) ────────────────
FRONTEND_URL=http://localhost:3001

# ── AI Health Assistant ("Lucy") ──────────────────────────────────────────────
# Required for POST /api/ai/chat. Without it the endpoint returns 503 and the
# frontend shows its "Coming Soon" panel. This key must live ONLY here — it was
# previously bundled into the Angular app, where every user could read it.
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b
AI_MAX_TOKENS=1024
AI_REQUEST_TIMEOUT_MS=30000
# Turns of conversation history forwarded upstream — caps prompt size and spend.
AI_MAX_HISTORY_MESSAGES=20

