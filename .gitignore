# Dependencies
node_modules/
.pnp
.pnp.js

# Build output
dist/
build/

# Throwaway scripts run through ts-node from the repo root (one-off migration or
# data checks). ts-node emits .js/.d.ts/.js.map siblings, and deleting only the .ts
# leaves those behind — where nothing else in this file would have caught them.
*.tmp.ts
*.tmp.js
*.tmp.d.ts
*.tmp.js.map

# Environment files — never commit real values
.env
.env.local
.env.development
.env.staging
.env.production
.env.example

# TypeORM cache
.tsbuildinfo

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/
*.swp
*.swo

# Coverage
coverage/
.nyc_output/

# Jest cache
.jest-cache/

# TypeScript incremental compilation
*.tsbuildinfo

# Lock files — commit pnpm-lock.yaml, ignore alternatives
yarn.lock
package-lock.json
